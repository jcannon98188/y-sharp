{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://y-sharp/schema/ops.schema.json",
  "title": "y-sharp ops script (schema 1)",
  "description": "Normative step vocabulary of ADR 0011/0016. Both interpreters (tools/fixture-gen and tests/YSharp.TestKit) replay exactly these kinds and fields. Adding a kind needs a change here, an interpreter on each side and a [Covers] entry.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "replicas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replicaDecl"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "required": [
    "schema"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "replicaName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "description": "A replica declared in replicas (checked by the interpreters, not by this schema)."
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "replicaDecl": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/replicaName"
        },
        "clientId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "gc": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "clientId"
      ],
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "array",
            "map",
            "xmlFragment"
          ]
        }
      },
      "required": [
        "root",
        "kind"
      ],
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {
          "$ref": "#/$defs/root"
        },
        {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/root"
            }
          ],
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        }
      ]
    },
    "bytes": {
      "type": "object",
      "properties": {
        "$": {
          "const": "bytes"
        },
        "hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        }
      },
      "required": [
        "$",
        "hex"
      ],
      "additionalProperties": false
    },
    "value": {
      "description": "ADR 0011 tagged value. Plain: null, booleans, finite numbers other than -0, strings without lone surrogates, arrays. Tagged objects carry \"$\".",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "required": [
            "$"
          ],
          "oneOf": [
            {
              "properties": {
                "$": {
                  "enum": [
                    "undefined",
                    "nan",
                    "inf",
                    "-inf",
                    "-0"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "properties": {
                "$": {
                  "const": "bigint"
                },
                "v": {
                  "type": "string",
                  "pattern": "^-?[0-9]+$"
                }
              },
              "required": [
                "v"
              ],
              "additionalProperties": false
            },
            {
              "properties": {
                "$": {
                  "const": "bytes"
                },
                "hex": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                }
              },
              "required": [
                "hex"
              ],
              "additionalProperties": false
            },
            {
              "properties": {
                "$": {
                  "const": "str"
                },
                "units": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                }
              },
              "required": [
                "units"
              ],
              "additionalProperties": false
            },
            {
              "properties": {
                "$": {
                  "const": "obj"
                },
                "pairs": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/value"
                      }
                    ]
                  }
                }
              },
              "required": [
                "pairs"
              ],
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "title": "replica",
          "type": "object",
          "properties": {
            "step": {
              "const": "replica"
            },
