<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-process canary host (ADR 0013): runs only the HOS-DEEP document-depth cases, so a stack overflow is reported by the
       test project as a named failure instead of killing the test run. Not a test project; built with the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>YSharp.Fuzz.Canary</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\YSharp.Fuzz.Tests\Builder\UpdateBuilder.cs" Link="UpdateBuilder.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\YSharp\YSharp.csproj" />
  </ItemGroup>
</Project>
