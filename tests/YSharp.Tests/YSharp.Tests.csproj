<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FsCheck.Xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YSharp.TestKit\YSharp.TestKit.csproj" />
    <ProjectReference Include="..\..\src\YSharp\YSharp.csproj" />
    <!-- The M0 spike content layer and the harness (ADR 0018). The harness sources are compiled into the spike project, not here. -->
    <ProjectReference Include="..\..\spike\YSharp.StoreSpike\YSharp.StoreSpike.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Allocation\Spike\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The benchmark comparison has no dependencies, so the gating tests compile it directly instead of referencing the BenchmarkDotNet project (Spec 14). -->
    <Compile Include="..\..\bench\YSharp.Benchmarks\Comparison\BenchmarkComparison.cs" Link="Allocation\Comparison\BenchmarkComparison.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="TestKit/Node/echo-server.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
